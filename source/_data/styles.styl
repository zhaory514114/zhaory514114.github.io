:root {
  --paper: #FFFFFF;
  --gold: #FFC23F;
  --blue: #2D53B5;
  --orange: #FF6321;
}
body {
  background: var(--blue);
  color: var(--blue);
}
.header {
  position: relative;
  overflow: hidden;
  background: var(--paper);
  border-bottom: 6px solid var(--gold);
}
.site-brand-container {
  background: var(--paper);
  color: var(--blue);
}
.site-title, .site-subtitle, .menu-item a {
  color: var(--blue) !important;
}
.blog-character {
  position: absolute;
  right: 18px;
  bottom: 0;
  width: 130px;
  height: 130px;
  object-fit: contain;
  object-position: center bottom;
  pointer-events: none;
}
.main-inner, .post-block, .comments, .pagination {
  background: var(--paper);
}
.post-block {
  border-top: 7px solid var(--gold);
}
.post-title, .post-title-link {
  color: var(--blue) !important;
  text-decoration: none !important;
  border-bottom: 0 !important;
}
.post-title {
  padding: 10px;
  background: var(--gold);
  font-size: 1.45em;
}
.post-body, .post-meta, .category-all, .collection-title {
  color: var(--blue);
}
a {
  color: var(--blue);
}
.btn, .post-button .btn {
  color: var(--paper) !important;
  background: var(--orange) !important;
  border-color: var(--orange) !important;
}
.btn:hover, .post-button .btn:hover {
  color: var(--orange) !important;
  background: var(--paper) !important;
}
.sidebar {
  background: var(--blue);
}
.sidebar-inner,
.sidebar-inner * {
  color: #2D53B5 !important;
}

.site-author-name,
.site-overview .site-author-name,
p.site-author-name {
  color: var(--blue) !important;
}

.site-description {
  color: var(--blue) !important;
}
.footer {
  color: var(--gold);
}
@media (max-width: 767px) {
  .blog-character {
    right: 8px;
    width: 96px;
    height: 96px;
  }
  .post-title {
    font-size: 1.2em;
  }
}
/* 顶部折叠菜单按钮 */
.site-nav-toggle {
  display: block !important;
  background: #FF6321 !important;
}

.site-nav-toggle .btn-bar {
  background: #FFFFFF !important;
}

/* NexT 侧边栏按钮 */
.sidebar-toggle {
  background: #FF6321 !important;
}
.site-author-name {
  display: block !important;
  color: #2D53B5 !important;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  margin-top: 12px;
}

.sidebar-toggle-line {
  background: #FFFFFF !important;
}
.links-of-author .links-of-author-item a {
  display: block;
  padding: 7px 9px;
  color: #2D53B5 !important;
  background: #FFC23F !important;
  border-radius: 4px;
  text-decoration: none !important;
}

.links-of-author .links-of-author-item a i {
  color: #2D53B5 !important;
}

.links-of-author .links-of-author-item a:hover {
  color: #FFFFFF !important;
  background: #FF6321 !important;
}

.links-of-author .links-of-author-item a:hover i {
  color: #FFFFFF !important;
}
.site-overview .site-author-name,
.sidebar-inner .site-author-name {
  display: block !important;
  color: #2D53B5 !important;
  font-size: 18px !important;
  font-weight: 600 !important;
  text-align: center;
}
.sidebar-inner .site-author-name,
.sidebar-inner .site-author-name *,
.site-overview .site-author-name,
.site-overview .site-author-name * {
  color: #2D53B5 !important;
  opacity: 1 !important;
}
/* 强制修复头像信息区域的文字颜色 */
.sidebar-inner {
  --text-color: #2D53B5 !important;
  --link-color: #2D53B5 !important;
  --link-hover-color: #FF6321 !important;
}

.sidebar-inner .site-author-name,
.sidebar-inner .site-description,
.sidebar-inner .site-state-item,
.sidebar-inner .site-state-item *,
.sidebar-inner .links-of-author,
.sidebar-inner .links-of-author * {
  color: #2D53B5 !important;
  -webkit-text-fill-color: #2D53B5 !important;
  opacity: 1 !important;
}

/* 跳转按钮 */
.sidebar-inner .links-of-author-item a {
  color: #2D53B5 !important;
  -webkit-text-fill-color: #2D53B5 !important;
  background: #FFC23F !important;
}

/* 跳转按钮悬停 */
.sidebar-inner .links-of-author-item a:hover,
.sidebar-inner .links-of-author-item a:hover * {
  color: #FFFFFF !important;
  -webkit-text-fill-color: #FFFFFF !important;
  background: #FF6321 !important;
}
/* 隐藏头像下方的博客简介 */
.site-description {
  display: none !important;
}

/* 缩小网站整体字体 */
body {
  font-size: 14px !important;
}

/* 正文 */
.post-body {
  font-size: 14px !important;
  line-height: 1.8;
}

/* 文章标题 */
.post-title {
  font-size: 20px !important;
}

/* 网站名称 */
.site-title {
  font-size: 22px !important;
}

/* 顶部目录 */
.menu-item a {
  font-size: 14px !important;
}

/* 头像区域和账号链接 */
.site-author-name {
  font-size: 16px !important;
}

.site-state,
.links-of-author {
  font-size: 13px !important;
}

/* 日期、分类等文章信息 */
.post-meta {
  font-size: 12px !important;
}
/* 全站字体缩小 */
html,
body {
  font-size: 13px !important;
}

/* 普通正文 */
.post-body,
.post-body p,
.post-body li,
.post-body table,
.post-body blockquote {
  font-size: 13px !important;
  line-height: 1.75 !important;
}

/* 文章标题 */
.posts-expand .post-title,
.posts-expand .post-title-link {
  font-size: 18px !important;
}

/* 正文小标题 */
.post-body h1 {
  font-size: 20px !important;
}

.post-body h2 {
  font-size: 18px !important;
}

.post-body h3 {
  font-size: 16px !important;
}

.post-body h4,
.post-body h5,
.post-body h6 {
  font-size: 14px !important;
}

/* 网站标题与目录 */
.site-title {
  font-size: 20px !important;
}

.site-subtitle,
.menu-item a {
  font-size: 13px !important;
}

/* 日期和分类 */
.post-meta,
.post-meta-item {
  font-size: 11px !important;
}

/* 左侧头像区域 */
.site-author-name {
  font-size: 15px !important;
}

.site-state,
.site-state-item,
.links-of-author,
.links-of-author-item {
  font-size: 12px !important;
}

/* 页脚 */
.footer,
.footer-inner {
  font-size: 12px !important;
}
/* 顶部：隐藏文字，使用蓝黄背景图 */
.header {
  min-height: 160px !important;
  background-color: #2D53B5 !important;
  background-image: url('/images/header-background.png') !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-size: contain !important;
}

/* 去掉网站名称和副标题 */
.site-title,
.site-subtitle {
  display: none !important;
}

/* 让原来的白色标题区域透明 */
.site-brand-container,
.header-inner {
  min-height: 160px !important;
  background: transparent !important;
}

/* 保留左侧菜单按钮 */
.site-nav-toggle {
  display: block !important;
  position: relative;
  z-index: 10;
}

/* 保留右侧人物，并放在背景上层 */
.blog-character {
  display: block !important;
  z-index: 5;
}
/* 选中文字时的颜色 */
::selection {
  background: #FF6321 !important;
  color: #FFFFFF !important;
}

::-moz-selection {
  background: #FF6321 !important;
  color: #FFFFFF !important;
}
/* 展开的顶部目录改为白色 */
.site-nav,
.menu {
  background: #FFFFFF !important;
}

.menu .menu-item,
.menu .menu-item a {
  color: #2D53B5 !important;
  background: #FFFFFF !important;
  -webkit-text-fill-color: #2D53B5 !important;
}

.menu .menu-item a:hover,
.menu .menu-item-active a {
  color: #FFFFFF !important;
  background: #FF6321 !important;
  -webkit-text-fill-color: #FFFFFF !important;
}

/* 调整右侧人物位置 */
.blog-character {
  top: 34px !important;
  bottom: auto !important;
  right: 18px !important;
}

@media (max-width: 767px) {
  .blog-character {
    top: 34px !important;
    bottom: auto !important;
    right: 8px !important;
  }
}
/* 深色模式：原本的蓝色文字改为黄色 */
@media (prefers-color-scheme: dark) {
  body,
  a,
  .post-title,
  .post-title-link,
  .post-body,
  .post-meta,
  .category-all,
  .collection-title,
  .menu-item a,
  .site-author-name,
  .site-description,
  .site-state-item,
  .site-state-item *,
  .links-of-author,
  .links-of-author * {
    color: #FFC23F !important;
    -webkit-text-fill-color: #FFC23F !important;
  }

  /* 橘红色按钮继续使用白字 */
  .btn,
  .post-button .btn,
  .menu-item-active a,
  .menu-item a:hover {
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
  }
}
@media (prefers-color-scheme: dark) {
  code,
  pre {
    color: #FFC23F !important;
    -webkit-text-fill-color: #FFC23F !important;
  }
}
