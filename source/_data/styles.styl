:root {
  --paper: #FFFFFF;
  --gold: #FFC23F;
  --blue: #2D53B5;
  --orange: #FF6321;
}
body {
  background: var(--blue);
  color: var(--blue);
}
.header {
  position: relative;
  overflow: hidden;
  background: var(--paper);
  border-bottom: 6px solid var(--gold);
}
.site-brand-container {
  background: var(--paper);
  color: var(--blue);
}
.site-title, .site-subtitle, .menu-item a {
  color: var(--blue) !important;
}
.blog-character {
  position: absolute;
  right: 18px;
  bottom: 0;
  width: 130px;
  height: 130px;
  object-fit: contain;
  object-position: center bottom;
  pointer-events: none;
}
.main-inner, .post-block, .comments, .pagination {
  background: var(--paper);
}
.post-block {
  border-top: 7px solid var(--gold);
}
.post-title, .post-title-link {
  color: var(--blue) !important;
  text-decoration: none !important;
  border-bottom: 0 !important;
}
.post-title {
  padding: 10px;
  background: var(--gold);
  font-size: 1.45em;
}
.post-body, .post-meta, .category-all, .collection-title {
  color: var(--blue);
}
a {
  color: var(--blue);
}
.btn, .post-button .btn {
  color: var(--paper) !important;
  background: var(--orange) !important;
  border-color: var(--orange) !important;
}
.btn:hover, .post-button .btn:hover {
  color: var(--orange) !important;
  background: var(--paper) !important;
}
.sidebar {
  background: var(--blue);
}
.sidebar-inner,
.sidebar-inner * {
  color: #2D53B5 !important;
}

.site-author-name,
.site-overview .site-author-name,
p.site-author-name {
  color: var(--blue) !important;
}

.site-description {
  color: var(--blue) !important;
}
.footer {
  color: var(--gold);
}
@media (max-width: 767px) {
  .blog-character {
    right: 8px;
    width: 96px;
    height: 96px;
  }
  .post-title {
    font-size: 1.2em;
  }
}
/* 顶部折叠菜单按钮 */
.site-nav-toggle {
  display: block !important;
  background: #FF6321 !important;
}

.site-nav-toggle .btn-bar {
  background: #FFFFFF !important;
}

/* NexT 侧边栏按钮 */
.sidebar-toggle {
  background: #FF6321 !important;
}
.site-author-name {
  display: block !important;
  color: #2D53B5 !important;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  margin-top: 12px;
}

.sidebar-toggle-line {
  background: #FFFFFF !important;
}
.links-of-author .links-of-author-item a {
  display: block;
  padding: 7px 9px;
  color: #2D53B5 !important;
  background: #FFC23F !important;
  border-radius: 4px;
  text-decoration: none !important;
}

.links-of-author .links-of-author-item a i {
  color: #2D53B5 !important;
}

.links-of-author .links-of-author-item a:hover {
  color: #FFFFFF !important;
  background: #FF6321 !important;
}

.links-of-author .links-of-author-item a:hover i {
  color: #FFFFFF !important;
}
.site-overview .site-author-name,
.sidebar-inner .site-author-name {
  display: block !important;
  color: #2D53B5 !important;
  font-size: 18px !important;
  font-weight: 600 !important;
  text-align: center;
}
.sidebar-inner .site-author-name,
.sidebar-inner .site-author-name *,
.site-overview .site-author-name,
.site-overview .site-author-name * {
  color: #2D53B5 !important;
  opacity: 1 !important;
}
/* 强制修复头像信息区域的文字颜色 */
.sidebar-inner {
  --text-color: #2D53B5 !important;
  --link-color: #2D53B5 !important;
  --link-hover-color: #FF6321 !important;
}

.sidebar-inner .site-author-name,
.sidebar-inner .site-description,
.sidebar-inner .site-state-item,
.sidebar-inner .site-state-item *,
.sidebar-inner .links-of-author,
.sidebar-inner .links-of-author * {
  color: #2D53B5 !important;
  -webkit-text-fill-color: #2D53B5 !important;
  opacity: 1 !important;
}

/* 跳转按钮 */
.sidebar-inner .links-of-author-item a {
  color: #2D53B5 !important;
  -webkit-text-fill-color: #2D53B5 !important;
  background: #FFC23F !important;
}

/* 跳转按钮悬停 */
.sidebar-inner .links-of-author-item a:hover,
.sidebar-inner .links-of-author-item a:hover * {
  color: #FFFFFF !important;
  -webkit-text-fill-color: #FFFFFF !important;
  background: #FF6321 !important;
}
/* 隐藏头像下方的博客简介 */
.site-description {
  display: none !important;
}

/* 缩小网站整体字体 */
body {
  font-size: 14px !important;
}

/* 正文 */
.post-body {
  font-size: 14px !important;
  line-height: 1.8;
}

/* 文章标题 */
.post-title {
  font-size: 20px !important;
}

/* 网站名称 */
.site-title {
  font-size: 22px !important;
}

/* 顶部目录 */
.menu-item a {
  font-size: 14px !important;
}

/* 头像区域和账号链接 */
.site-author-name {
  font-size: 16px !important;
}

.site-state,
.links-of-author {
  font-size: 13px !important;
}

/* 日期、分类等文章信息 */
.post-meta {
  font-size: 12px !important;
}
